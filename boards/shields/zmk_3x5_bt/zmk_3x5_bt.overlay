/*
 * Copyright (c) 2026
 * SPDX-License-Identifier: MIT
 *
 * ZMK 3x5 Bluetooth Keyboard Shield
 * Board: nice!nano / Pro Micro (NRF52840)
 * Matrix: 3 rows x 5 columns, ROW2COL diode orientation (anode→row, cathode→col)
 * Row pins: D0, D1, D2 (driven outputs)
 * Col pins: D3, D4, D5, D6, D7 (sensed inputs, pulled down)
 * NOTE: PCB column bus is physically mirrored (leftmost key → D7/col4),
 * so the transform map reverses each row to keep keymap order YUIOP/HJKL;/NM,.
 *
 * RGB: WS2812B×15 on D8 (P1.04) via SPI3.
 *   P1.04 = SPIM3.MOSI on nRF52840. The worldsemi,ws2812-spi driver
 *   reuses the SPI peripheral and serializes WS2812B bits over MOSI.
 *   SCK=P0.26 supplies the SPI clock (not wired to WS2812, but required
 *   by the SPIM controller to shift out data).
 *
 * IMPORTANT: use the SPI backend, NOT worldsemi,ws2812-gpio. The GPIO
 * backend (ws2812_gpio.c) is nRF51-only (depends on SOC_SERIES_NRF51X
 * and is hard-coded to nRF51 inline assembly) and cannot run on the
 * nRF52840. The SPI backend is portable to nRF52.
 */

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,led-strip = &led_strip;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios =
            <&pro_micro 0 GPIO_ACTIVE_HIGH>,
            <&pro_micro 1 GPIO_ACTIVE_HIGH>,
            <&pro_micro 2 GPIO_ACTIVE_HIGH>;

        col-gpios =
            <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <3>;
        map = <
            RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
        >;
    };

    /* Custom pinctrl states for SPI3 WS2812B.
     * Placed directly under / (named nodes) and referenced by phandle
     * from &spi3 below; they are not wrapped in a `pinctrl {}` node so
     * they do not collide with the SoC's `pinctrl: pin-controller`.
     *
     * PSEL encoding (Nordic nRF52): bits 0-4=pin, bits 5-7=port, bits 8-12=function.
     *   MOSI P1.04 = (2<<8)|(1<<5)|4  = 0x224
     *   SCK  P0.26 = (2<<8)|(0<<5)|26 = 0x11A
     */
    spi3_ws2812_default: spi3_ws2812_default {
        group1 {
            psels = <0x224>, <0x11A>;
        };
    };

    spi3_ws2812_sleep: spi3_ws2812_sleep {
        group1 {
            psels = <0x224>, <0x11A>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_ws2812_default>;
    pinctrl-1 = <&spi3_ws2812_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* Data input line. Required by the ZMK zephyr ws2812-spi binding. */
        in-gpios = <&pro_micro 8 GPIO_ACTIVE_HIGH>;

        /* SPI */
        reg = <0>; /* ignored, but required by the SPI device binding */
        spi-max-frequency = <4000000>;

        /* WS2812B: one SPI frame = one WS2812 bit.
         * 1-pulse (T1H≈0.7μs):  0x70 = 0111_0000
         * 0-pulse (T0L≈0.35μs): 0x40 = 0100_0000
         * (2 MHz SPI × 0.5 μs/bit ≈ WS2812 800 kHz) */
        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        /* WS2812B */
        chain-length = <15>; /* 15 LEDs: 5 per row × 3 rows */
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};
