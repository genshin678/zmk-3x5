 *
 * ZMK 3x5 Bluetooth Keyboard Shield
 * Board: nice!nano / Pro Micro (NRF52840)
 *
 * RGB: WS2812B x15 on D8 (P1.04) via SPI3
 */

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>


/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,led-strip = &led_strip;
    };


    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios =
            <&pro_micro 0 GPIO_ACTIVE_HIGH>,
            <&pro_micro 1 GPIO_ACTIVE_HIGH>,
            <&pro_micro 2 GPIO_ACTIVE_HIGH>;

        col-gpios =
            <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };


    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";

        columns = <5>;
        rows = <3>;

        map = <
            RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
        >;
    };


    spi3_ws2812_default: spi3_ws2812_default {
        group1 {
            psels = <0x224>;
        };

        group2 {
            psels = <0x11A>, <0x21B>, <0x40C>;
        };
    };


    spi3_ws2812_sleep: spi3_ws2812_sleep {
        group1 {
            psels = <0x224>,
                    <0x11A>,
                    <0x21B>,
                    <0x40C>;

            low-power-enable;
        };
    };
};



&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_ws2812_default>;
    pinctrl-1 = <&spi3_ws2812_sleep>;
    pinctrl-names = "default", "sleep";


    #address-cells = <1>;
    #size-cells = <0>;


    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        reg = <0>;

        spi-max-frequency = <4000000>;

        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        chain-length = <15>;

        color-mapping =
            <LED_COLOR_ID_GREEN
             LED_COLOR_ID_RED
             LED_COLOR_ID_BLUE>;
    };
};
