/*
 * Copyright (c) 2026
 * SPDX-License-Identifier: MIT
 *
 * ZMK 3x5 Bluetooth Keyboard Shield
 * Board: nice!nano / Pro Micro (NRF52840)
 * Matrix: 3 rows x 5 columns, ROW2COL diode orientation (anode→row, cathode→col)
 * Row pins: D0, D1, D2 (driven outputs)
 * Col pins: D3, D4, D5, D6, D7 (sensed inputs, pulled down)
 * NOTE: PCB column bus is physically mirrored (leftmost key → D7/col4),
 * so the transform map reverses each row to keep keymap order YUIOP/HJKL;/NM,.
 *
 * RGB: WS2812B×15 on D8 (P1.04) via SPI3.
 *   P1.04 = SPIM3.MOSI on nRF52840. The worldsemi,ws2812-spi driver
 *   reuses the SPI peripheral and serializes WS2812B bits over MOSI.
 *   SCK=P0.26 supplies the SPI clock (not wired to WS2812, but required
 *   by the SPIM controller to shift out data).
 *
 * IMPORTANT: use the SPI backend, NOT worldsemi,ws2812-gpio. The GPIO
 * backend (ws2812_gpio.c) is nRF51-only (depends on SOC_SERIES_NRF51X
 * and is hard-coded to nRF51 inline assembly) and cannot run on the
 * nRF52840. The SPI backend is portable to nRF52.
 */

#include <dt-bindings/led/led.h>
#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/pinctrl/nrf-pinctrl.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,led-strip = &led_strip;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios =
            <&pro_micro 0 GPIO_ACTIVE_HIGH>,
            <&pro_micro 1 GPIO_ACTIVE_HIGH>,
            <&pro_micro 2 GPIO_ACTIVE_HIGH>;

        col-gpios =
            <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
            <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <3>;
        map = <
            RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
        >;
    };

};

/*
 * EXTERNAL POWER (3.3V/VCC RAIL) POLARITY - DO NOT REMOVE
 * -------------------------------------------------------
 * The nice!nano header pin driven by P0.13 is the switched 3.3V/VCC output.
 * ZMK's stock board file (zephyr/boards/.../nice_nano.dts) declares it as
 *
 *     EXT_POWER { compatible = "zmk,ext-power-generic";
 *                 control-gpios = <&gpio0 13 GPIO_ACTIVE_LOW>; };
 *
 * which is correct for a GENUINE nice!nano (P0.13 pulled LOW = rail ON).
 * ZMK's driver unconditionally ENABLES external power at boot
 * (ext_power_generic_init() -> ext_power_enable() -> gpio_pin_set_dt(gpio, 1)),
 * so on a genuine board the rail comes up LOW = ON.
 *
 * THIS PCB's module has the OPPOSITE polarity - the vendor documentation for
 * this board states: "当 P0.13 设置为低时，将关闭 3.3V - VCC 引脚的电源"
 * (P0.13 LOW switches the rail OFF). Measured on the real board:
 *   - DFU/reset  (P0.13 floating, external pull-up): 3.3 V present  -> ON
 *   - firmware running (P0.13 driven LOW by ZMK):   ~0 V            -> OFF
 * i.e. the stock polarity turned the WS2812B/TXS0102 supply OFF the moment
 * ZMK booted, which is exactly the "LEDs never light" failure.
 *
 * Overriding with GPIO_ACTIVE_HIGH makes ZMK's "enabled" state drive P0.13
 * HIGH = rail ON on this hardware, and keeps the &ext_power behavior
 * (EP_ON/EP_OFF/EP_TOG) working with correct semantics.
 *
 * NOTE: &{/EXT_POWER} (path reference) is used because the board file defines
 * the node without a label - &EXT_POWER would not resolve.
 */
&{/EXT_POWER} {
    control-gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
};

&pinctrl {
    /* SPI3 = nRF52840 high-speed SPI (the only SPIM that can drive P1.x pins;
     * SPIM0/1/2 are P0-only). WS2812B data is on P1.04, so SPIM3 is mandatory.
     * These states MUST live under &pinctrl (compatible = "nordic,nrf-pinctrl")
     * or Zephyr fails with "Z_PINCTRL_STATE_PIN_INIT undeclared".
     * PSELs use the Zephyr v3.5 NRF_PSEL(fun,port,pin) bit layout:
     *   bits 6..0  = port*32 + pin
     *   bits 31..16 = function (SPIM_MOSI=5, SPIM_SCK=4). */
    spi3_ws2812_default: spi3_ws2812_default {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>,
                    <NRF_PSEL(SPIM_SCK, 0, 26)>;
        };
    };

    spi3_ws2812_sleep: spi3_ws2812_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_MOSI, 1, 4)>,
                    <NRF_PSEL(SPIM_SCK, 0, 26)>;
            low-power-enable;
        };
    };
};

&spi3 {
    compatible = "nordic,nrf-spim";
    status = "okay";

    pinctrl-0 = <&spi3_ws2812_default>;
    pinctrl-1 = <&spi3_ws2812_sleep>;
    pinctrl-names = "default", "sleep";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";

        /* NOTE: do NOT add an "in-gpios" property here. That property belongs
         * to the GPIO backend (worldsemi,ws2812-gpio) only. The SPI backend
         * (worldsemi,ws2812-spi) shifts data out over MOSI, so it declares no
         * data-pin property, and adding one aborts the build with:
         *   devicetree error: 'in-gpios' appears in .../ws2812@0 ...
         *   but is not declared in 'properties:' in worldsemi,ws2812-spi.yaml
         */

        /* SPI
         *
         * reg is required by the worldsemi,ws2812-spi binding (the value is
         * ignored - the driver shifts out over MOSI) but omitting it aborts
         * the build with:
         *   devicetree error: 'reg' is marked as required in 'properties:' */
        reg = <0>;

        /* Zephyr's ws2812_spi driver serialises ONE WS2812 bit into ONE FULL
         * SPI BYTE (ws2812_spi_ser(): buf[i] = bit ? one_frame : zero_frame,
         * 8 bytes per colour channel), so a pulse is 3 or 1 SPI bits wide:
         *
         *   1-pulse: 0x70 = 0111_0000    0-pulse: 0x40 = 0100_0000
         *   T1H = 3 SPI bits,  T0H = 1 SPI bit,  WS bit = 8 SPI bits
         *
         *   clock   T1H = 3 bits    T0H = 1 bit      WS bit = 8 bits
         *   4 MHz   0.75 us         0.25 us          2.00 us  <- NEW board (AHCT1G125)
         *   2 MHz   1.50 us *       0.50 us          4.00 us  <- this build (TXS0102)
         *   WS2812B 0.65-0.95 us    0.25-0.55 us     >= 0.65 us
         *     (*) 1.50 us EXCEEDS the 0.95 us MAX. It still decodes as "1" on
         *         tolerant dies (HIGH >> 0.55 us threshold) but is out of spec
         *         and 3.2x slower than the 1.25 us nominal bit.
         *
         * CRITICAL - nRF52840 SPIM frequency is DISCRETE (125k/250k/500k/1M/
         * 2M/4M/8M/16M/32M). Zephyr's get_nrf_spim_frequency() FLOORS the
         * requested value to the nearest supported one. The previous
         * <3200000> did NOT run at 3.2 MHz - it was silently floored to 2 MHz
         * (the basis of the old timing comment was never the real clock).
         * Always specify an EXACT supported frequency.
         *
         * This build keeps 2 MHz because U1(TXS0102) was removed and P1.04 now
         * drives the 5V LEDs directly at MCU 3.3V (no level shifter). At the
         * marginal 3.3V < 3.5V threshold, 2 MHz's long 1.5us T1H is decoded
         * more reliably than 4 MHz's 0.75us would be - raising the clock would
         * make decode WORSE, not better. The NEW board adds 74AHCT1G125 (5V
         * push-pull) and there sets spi-max-frequency = <4000000>:
         * for a centred T1H=0.75 us (0.65-0.95 window) and T0H=0.25 us (MIN,
         * safe with clean edges). */
        spi-max-frequency = <2000000>;

        spi-one-frame = <0x70>;
        spi-zero-frame = <0x40>;

        /* Latch gap after each frame. The classic WS2812B needs > 50 us, but
         * the newer WS2812B-V5 die needs >= 280 us before it latches, and this
         * strip's exact variant is unknown. The board idles far longer than
         * that between frames, so this is pure insurance. */
        reset-delay = <300>;

        /* WS2812B chain length. TEMPORARY: this build targets the 4-pixel
         * bring-up board used to validate the new ST-1209RGB LED plus the
         * MT3608 5V rail and 74AHCT1G125 level shifter, ahead of committing
         * the TOPOLOGY-SAFE full 15-pixel board. Restore to <15> before the
         * real board is populated (and re-check LED_PIXEL_COUNT below). */
        chain-length = <4>; /* 4 LEDs: bring-up test board */
        color-mapping = <LED_COLOR_ID_GREEN
                         LED_COLOR_ID_RED
                         LED_COLOR_ID_BLUE>;
    };
};
