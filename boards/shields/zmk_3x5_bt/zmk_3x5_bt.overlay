/*
 * Copyright (c) 2026
 * SPDX-License-Identifier: MIT
 *
 * ZMK 3x5 Bluetooth Keyboard Shield
 * Board: nice!nano / Pro Micro (NRF52840)
 * Matrix: 3 rows x 5 columns, ROW2COL diode orientation (anode→Row, cathode→Col)
 * Row pins: D0, D1, D2 (driven outputs)
 * Col pins: D3, D4, D5, D6, D7 (sensed inputs, pulled down)
 * NOTE: PCB column bus is physically mirrored (leftmost key → D7/col4),
 * so the transform map reverses each row to keep keymap order YUIOP/HJKL;/NM,.
 *
 * RGB: WS2812B on D8 (P1.04) via SPI3 bitbang.
 *   P1.04 is SPI3 MOSI on nRF52840.  The worldsemi,ws2812-spi driver
 *   reuses the SPI peripheral and bitbangs the WS2812B timing.
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,led-strip = &led_strip;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "row2col";

        row-gpios
            = <&pro_micro 0 GPIO_ACTIVE_HIGH>
            , <&pro_micro 1 GPIO_ACTIVE_HIGH>
            , <&pro_micro 2 GPIO_ACTIVE_HIGH>
            ;

        col-gpios
            = <&pro_micro 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pro_micro 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;
    };

    default_transform: keymap_transform0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <3>;
        map = <
            RC(0,4) RC(0,3) RC(0,2) RC(0,1) RC(0,0)
            RC(1,4) RC(1,3) RC(1,2) RC(1,1) RC(1,0)
            RC(2,4) RC(2,3) RC(2,2) RC(2,1) RC(2,0)
        >;
    };
};

/ {
    /* Custom pinctrl for SPI3: only MOSI (P1.04 = D8) is used by WS2812B.
     * SCK / MISO / CS are not connected but the SPI peripheral still
     * wants them initialised to a valid (low-power) state.
     * NOTE: must NOT use the `pinctrl:` label or wrap in a `pinctrl {}`
     * child node — the nRF52840 SoC already labels its pinctrl-controller
     * `pinctrl`, which would cause a devicetree label-collision error.
     * Put the state directly under / and label only the state itself. */
    spi3_ws2812_default: spi3_ws2812_default {
        group1 {
            /* P1.04 = D8, SPIM3.MOSI function. PSEL encoding:
             *   bits 0-4 = pin, bits 5-7 = port, bits 8-12 = function.
             *   0x224 = (2<<8) | (1<<5) | 4 = MOSI, port 1, pin 4. */
            psels = <0x224>;
        };
        group2 {
            /* SCK P0.26, MISO P0.27, CSN P0.12 — chosen as harmless
             * low-power defaults; the WS2812B driver only toggles MOSI. */
            psels = <0x11A>,
                    <0x31B>,
                    <0x40C>;
        };
    };
};

&spi3 {
    status = "okay";
    pinctrl-0 = <&spi3_ws2812_default>;
    pinctrl-names = "default";

    led_strip: ws2812@0 {
        compatible = "worldsemi,ws2812-spi";
        reg = <0>;
        spi-max-frequency = <4000000>;
        spi-one-wire;
        chain-length = <15>;
        color-mapping = "GRB";
    };
};
